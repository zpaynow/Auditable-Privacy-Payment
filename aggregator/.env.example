# One instance serves every chain that has a deployment file here (solidity/deployments/<chainId>.json).
DEPLOYMENTS_DIR=../solidity/deployments
# optional: only serve these chain ids (comma-separated)
# CHAINS=968,84532

# Per-chain settings use a _<chainId> suffix and fall back to the unsuffixed name.
RPC_URL_968=https://rpc.bohr.life
RPC_URL_84532=https://sepolia.base.org
# operator EOA (must be whitelisted with APP.setOperator on that chain); pays gas, receives withdraw fees
OPERATOR_KEY=0x...
# OPERATOR_KEY_968=0x...

# fees in base units of FEE_ASSET on each chain (USDT / tUSD with 6 decimals: 10000 = 0.01)
FEE_ASSET=1
TRANSFER_FEE=10000
WITHDRAW_FEE=10000
# TRANSFER_FEE_968=20000
BATCH_MAX=10
BATCH_INTERVAL_SECS=30

# BabyJubJub secret (32 bytes LE hex, from `app-tools keygen`) owning the fee notes of batched transfers (all chains)
AGGREGATOR_SECRET=0x...
# directory with *.vk files from `app-tools setup`
KEYS_DIR=../artifacts
DB_PATH=aggregator.sqlite
PORT=8787
