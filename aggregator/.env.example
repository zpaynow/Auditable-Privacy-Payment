# chain
RPC_URL=http://127.0.0.1:8545
APP_ADDRESS=0x0000000000000000000000000000000000000000
# operator EOA (must be whitelisted with APP.setOperator); pays gas, receives withdraw fees
OPERATOR_KEY=0x...
# BabyJubJub secret (32 bytes LE hex, from `app-tools keygen`) owning the fee notes of batched transfers
AGGREGATOR_SECRET=0x...
# directory with *.vk files from `app-tools setup`
KEYS_DIR=../artifacts
# fees in base units of FEE_ASSET (tUSD has 6 decimals: 10000 = 0.01)
FEE_ASSET=1
TRANSFER_FEE=10000
WITHDRAW_FEE=10000
# batching
BATCH_MAX=10
BATCH_INTERVAL_SECS=30
DB_PATH=aggregator.sqlite
PORT=8787
