# One instance serves every chain that has a deployment file here (solidity/deployments/<chainId>.json).
DEPLOYMENTS_DIR=../solidity/deployments
# optional: only serve these chain ids (comma-separated)
# CHAINS=968,84532

# Per-chain settings use a _<chainId> suffix and fall back to the unsuffixed name.
RPC_URL_968=https://rpc.bohr.life
RPC_URL_84532=https://sepolia.base.org
# auditor BabyJubJub secret (32 bytes LE hex, from `app-tools keygen`); must match auditorX/Y in the deployment file
AUDITOR_SECRET=0x...
# AUDITOR_SECRET_968=0x...
POLL_SECS=3

DB_PATH=auditor.sqlite
PORT=8788
# optional: token for the /chains/{id}/audit/* endpoints (full decrypted view); unset = disabled
ADMIN_TOKEN=
