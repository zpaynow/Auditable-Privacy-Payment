RPC_URL=http://127.0.0.1:8545
APP_ADDRESS=0x0000000000000000000000000000000000000000
# auditor BabyJubJub secret (32 bytes LE hex, from `app-tools keygen`) — opens every audit memo
AUDITOR_SECRET=0x...
# first block to index (deployBlock from solidity/deployments/<chainId>.json)
DEPLOY_BLOCK=0
POLL_SECS=3
DB_PATH=auditor.sqlite
PORT=8788
# optional: token for the /audit/* endpoints (full decrypted view); unset = disabled
ADMIN_TOKEN=
