# Build-time settings for the web app (Vite reads VITE_* at `npm run build`)
# Aggregator service (Phase 2). Must be https when the site is served over https.
VITE_AGGREGATOR_URL=https://aggregator.example.com
# Auditor indexing service. Must be https when the site is served over https.
VITE_AUDITOR_URL=https://auditor.example.com
# Proving keys (~50 MB). Default /keys = shipped with the site from public/keys.
# Point at an R2 / CDN bucket (with CORS allowing the site origin) to keep them out of the deploy.
VITE_KEYS_URL=/keys
